# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Priority AI Configuration (Optional)
# These are optional - if not provided, Priority AI features will be disabled
PRIORITY_AI_BASE_URL=https://your-priority-ai-api.com
PRIORITY_AI_API_KEY=your_priority_ai_api_key_here
