rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if user is admin (with error handling)
    // Note: This should NOT be used in users collection rules to avoid circular dependency
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().role == 'admin';
    }
    
    // Helper function to check if user is active (with error handling)
    function isActive() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             getUserData().isActive == true;
    }
    
    // Helper function to check if user is admin by reading their own document
    // Use this in users collection to avoid circular dependency
    function isAdminByOwnDoc() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection rules
    match /users/{userId} {
      // Users can always read their own data
      // Admins can read all users (check their own doc, not the target doc)
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      
      // Admins can create users OR a user can create their own document (for initial signup)
      allow create: if isAuthenticated() && (isAdmin() || request.auth.uid == userId);
      
      // Admins can update any user
      // Users can update their own data (except role and isActive fields)
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive']))
      );
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Beneficiaries collection
    match /beneficiaries/{beneficiaryId} {
      // Admins can read all beneficiaries
      // Staff can read all beneficiaries (for now, can restrict later if needed)
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isActive())
      );
      
      // Staff and admins can create beneficiaries
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isActive())
      );
      
      // Admins can update any beneficiary
      // Staff can only update beneficiaries they registered
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         isActive() && 
         resource.data.registeredBy == request.auth.uid)
      );
      
      // Only admins can delete beneficiaries
      allow delete: if isAdmin();
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

